# Copy this file to .env before running docker compose.
# Keep real credentials out of version control.

# Docker images
MYSQL_IMAGE=m.daocloud.io/docker.io/library/mysql:8.4.8
REDIS_IMAGE=m.daocloud.io/docker.io/library/redis:7-alpine
BUILDER_IMAGE=m.daocloud.io/docker.io/library/maven:3.9.6-eclipse-temurin-8
RUNTIME_IMAGE=m.daocloud.io/docker.io/library/eclipse-temurin:8-jre

# Published ports on the host machine
APP_PORT=8123
MYSQL_PORT=13306
REDIS_PORT=16379

# MySQL
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=z_picture
MYSQL_USER=root

# Redis inside the Docker network
REDIS_DATABASE=0
REDIS_HOST=redis
REDIS_PORT_INTERNAL=6379

# Runtime files
VIP_CODE_FILE_PATH=/app/data/vip-codes.json

# Tencent COS
COS_HOST=your-cos-host
COS_SECRET_ID=your-secret-id
COS_SECRET_KEY=your-secret-key
COS_REGION=ap-guangzhou
COS_BUCKET=your-bucket

# Aliyun DashScope
ALIYUN_AI_API_KEY=your-aliyun-dashscope-api-key
